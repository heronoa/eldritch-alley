{
  "name": "@eldritch-alley/platform-api",
  "version": "0.0.0",
  "private": true,
  "description": "Platform: accounts, rosters, rating, replays and matchmaking (NestJS)",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/main.js",
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate": "tsx --env-file-if-exists=../../.env src/migrate.ts",
    "migrate:create": "npm run build && mikro-orm migration:create --config dist/mikro-orm.config.js",
    "migrate:check": "npm run build && mikro-orm migration:check --config dist/mikro-orm.config.js"
  },
  "dependencies": {
    "@mikro-orm/core": "^6.6.17",
    "@mikro-orm/migrations": "^6.6.17",
    "@mikro-orm/postgresql": "^6.6.17",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "cookie-parser": "^1.4.7",
    "jose": "^6.2.12",
    "openid-client": "^6.8.8",
    "pg": "^8.20.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.6.17",
    "@nestjs/testing": "^11.2.7",
    "@types/cookie-parser": "^1.4.10",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "vitest": "^3.2.7"
  }
}
