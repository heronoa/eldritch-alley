# Copy to .env and adjust. .env is never committed.

# Postgres (docker compose)
POSTGRES_USER=eldritch
POSTGRES_PASSWORD=eldritch
POSTGRES_DB=eldritch_alley
DATABASE_URL=postgres://eldritch:eldritch@localhost:5432/eldritch_alley

# Redis (Colyseus presence and matchmaking queue)
REDIS_URL=redis://localhost:6379

# LocalStack (SQS for integration between game-server and platform-api)
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Auth (JWT issued by platform-api, validated by game-server)
JWT_SECRET=troque-em-producao

# Portas locais
PLATFORM_API_PORT=3000
GAME_SERVER_PORT=2567

# Frontend: the match server the client joins. Optional under `vite dev` (defaults to ws://localhost:2567).
# The production value lives in .env.production.
VITE_GAME_SERVER=ws://localhost:2567
