# Copy to .env and adjust. .env is never committed.

# Postgres (docker compose)
POSTGRES_USER=eldritch
POSTGRES_PASSWORD=eldritch
POSTGRES_DB=eldritch_alley
# Required by platform-api: it refuses to start without a postgres:// or postgresql:// URL.
# `npm run db:migrate` applies the schema; docker compose runs that step before the API starts.
DATABASE_URL=postgres://eldritch:eldritch@localhost:5432/eldritch_alley

# Redis (Colyseus presence and matchmaking queue)
REDIS_URL=redis://localhost:6379

# LocalStack (SQS for integration between game-server and platform-api)
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Auth (JWT issued by platform-api, validated by game-server)
JWT_SECRET=change-me-in-production

# Sign-in (m4-02). Every value below is read while platform-api is booting, so a missing or malformed
# one stops the service instead of failing on the first sign-in.
#
# The session cookie and the OAuth flow cookie are signed with this. One per environment, never reused:
#   openssl rand -base64 32
SESSION_SECRET=
# The parent domain the cookie is scoped to, so the client and the API share it.
COOKIE_DOMAIN=localhost
# Where the browser goes back after a sign-in, and the only origin CORS answers.
CLIENT_ORIGIN=http://localhost:5173
# What the providers send the browser back to. Register both callbacks in the OAuth apps:
#   http://localhost:3000/auth/github/callback
#   http://localhost:3000/auth/google/callback
OAUTH_REDIRECT_BASE_URL=http://localhost:3000
# The OAuth apps are your own and they are OPTIONAL: leave a pair blank and that provider is simply
# switched off — no button is drawn for it and its route answers 404. The project runs without any of
# them. Fill in one half of a pair and the service refuses to start, naming both variables, because half
# a credential is a typo rather than a choice. OAUTH_REDIRECT_BASE_URL is only read when at least one
# pair is filled in.
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# A Keycloak realm is optional and independent of the pairs above: set all three and Keycloak is one more
# button, offered beside whichever direct providers are configured. It does not replace or hide them.
# Leave all three blank and it is off. Half a set stops the service, naming what is missing. The issuer
# is the realm's URL, the same value the ID token carries — for example
# http://localhost:8080/realms/homelab — and the callback to register in the realm is
# ${OAUTH_REDIRECT_BASE_URL}/auth/keycloak/callback, not a route on the client.
OAUTH_KEYCLOAK_CLIENT_ID=
OAUTH_KEYCLOAK_CLIENT_SECRET=
OAUTH_KEYCLOAK_ISSUER=
# The game ticket's Ed25519 key pair. The private half stays out of the repository; game-server holds
# the public half as GAME_TICKET_PUBLIC_KEY (m4-03) and can verify a ticket but never issue one:
#   openssl genpkey -algorithm ed25519 -out game-ticket.pem
#   openssl pkey -in game-ticket.pem -pubout -out game-ticket.pub.pem
# Paste the private key on one line with its line breaks written as \n. docker compose turns those back
# into newlines itself, and platform-api does it for the readers that do not (node's --env-file):
#   GAME_TICKET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIE...\n-----END PRIVATE KEY-----\n"
GAME_TICKET_PRIVATE_KEY=
# How long a ticket is worth. Five minutes when unset, which is what the spec asks for.
GAME_TICKET_TTL_SECONDS=300
# The public half, and the only half the match server ever sees. Paste it the same way, line breaks as
# \n. The server runs without it — it authenticates nobody and plays every match as a guest — but a
# deployment that signs tickets should be verifying them, so docker compose asks for both halves:
#   GAME_TICKET_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMCowBQYDK2VwAyEA...\n-----END PUBLIC KEY-----\n"
GAME_TICKET_PUBLIC_KEY=

# Outgoing mail (m4-02): the verification link and the password reset link. All five values, or none.
# With none of them the platform writes each message to its log and opens nothing, which is the state
# `npm test` and `npm run dev` are meant to run in — nobody needs a mail account to work on this. With
# all five it sends. Fill in some and the service refuses to start, naming every value that is missing:
# half a mailer is a typo, and a mailer that silently swallows a reset is worse than one that stops.
#
# Zoho, which is what this deployment uses, as the worked example. The password is not the account's:
# Zoho issues an app-specific one under Mail > SMTP, and it only works with SMTP switched on for the
# account. `EMAIL_FROM` has to be an address (or an alias) the account is allowed to send as.
#   EMAIL_SMTP_HOST=smtp.zoho.com
#   EMAIL_SMTP_PORT=465
#   EMAIL_SMTP_USER=suporte@heronoa.com.br
#   EMAIL_SMTP_PASSWORD=<the app-specific password>
#   EMAIL_FROM=Eldritch Alley <suporte@heronoa.com.br>
# Port 465 is implicit TLS and 587 is STARTTLS; the adapter decides by the port, so give the right one.
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_FROM=

# Match recording (m4-03). The match server publishes every finished match here and the platform reads
# it back and writes it to the database, which is what the battle history is served from.
#
# Required by BOTH services, and neither has a default on purpose. A game-server without it loses the
# history of every match it hosts; a platform without it serves everybody an empty battle list. Neither
# failure is visible from any request, so both stop at boot while somebody is watching.
# `docker compose up` creates the queue and its dead-letter queue on LocalStack's first boot.
# This is the URL inside the compose network; for the host it is http://localhost:4566/000000000000/…
MATCH_ENDED_QUEUE_URL=http://localhost:4566/000000000000/match-ended.fifo
# How often the platform looks for finished matches. One second when unset, which is the delay a player
# sees between the end of a battle and their history showing it. Raise it if the polling shows up in the
# database bill; the queue holds what is not read yet either way.
MATCH_ENDED_POLL_INTERVAL_MS=1000

# Contact form and release e-mails (m4-05).
#
# The contact route stores a hash of the sender's address, never the address itself: `sha256(ip + salt)`,
# so the salt is what keeps the hash from being reversible by guessing. One per environment, and
# changing it only makes older rows unlinkable. Required: platform-api refuses to start without it.
CONTACT_IP_SALT=
# Where a stored contact message is announced. Required, and it is the owner's own inbox.
CONTACT_NOTIFY_TO=suporte@heronoa.com.br
# Cloudflare Turnstile verifies the contact form's token. Set the secret and the platform checks every
# message against Cloudflare, failing closed when the service cannot be reached. Leave it blank and the
# local fake accepts any token, which is what dev and `npm test` run on. The widget needs the matching
# site key on the client: VITE_TURNSTILE_SITE_KEY, read by the frontend's build.
TURNSTILE_SECRET=
# The form's limit per address hash: this many messages in this many seconds. Five messages per ten
# minutes when unset.
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_SECONDS=600

# Local ports
PLATFORM_API_PORT=3000
GAME_SERVER_PORT=2567
