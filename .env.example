# Copie para .env e ajuste. O .env nunca vai para o git.

# Postgres (docker compose)
POSTGRES_USER=mystic
POSTGRES_PASSWORD=mystic
POSTGRES_DB=mystic_alley
DATABASE_URL=postgres://mystic:mystic@localhost:5432/mystic_alley

# Redis (presença do Colyseus e fila de matchmaking)
REDIS_URL=redis://localhost:6379

# LocalStack (SQS para integração entre game-server e platform-api)
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Autenticação (JWT emitido pelo platform-api, validado pelo game-server)
JWT_SECRET=troque-em-producao

# Portas locais
PLATFORM_API_PORT=3000
GAME_SERVER_PORT=2567
