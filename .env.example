# Copy to .env and adjust. .env is never committed.

# Postgres (docker compose)
POSTGRES_USER=eldritch
POSTGRES_PASSWORD=eldritch
POSTGRES_DB=eldritch_alley
# Required by platform-api: it refuses to start without a postgres:// or postgresql:// URL.
# `npm run db:migrate` applies the schema; docker compose runs that step before the API starts.
DATABASE_URL=postgres://eldritch:eldritch@localhost:5432/eldritch_alley

# Redis (Colyseus presence and matchmaking queue)
REDIS_URL=redis://localhost:6379

# LocalStack (SQS for integration between game-server and platform-api)
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Auth (JWT issued by platform-api, validated by game-server)
JWT_SECRET=change-me-in-production

# Sign-in (m4-02). Every value below is read while platform-api is booting, so a missing or malformed
# one stops the service instead of failing on the first sign-in.
#
# The session cookie and the OAuth flow cookie are signed with this. One per environment, never reused:
#   openssl rand -base64 32
SESSION_SECRET=
# The parent domain the cookie is scoped to, so the client and the API share it.
COOKIE_DOMAIN=localhost
# Where the browser goes back after a sign-in, and the only origin CORS answers.
CLIENT_ORIGIN=http://localhost:5173
# What the providers send the browser back to. Register both callbacks in the OAuth apps:
#   http://localhost:3000/auth/github/callback
#   http://localhost:3000/auth/google/callback
OAUTH_REDIRECT_BASE_URL=http://localhost:3000
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
# The game ticket's Ed25519 key pair. The private half stays out of the repository; game-server holds
# the public half as GAME_TICKET_PUBLIC_KEY (m4-03) and can verify a ticket but never issue one:
#   openssl genpkey -algorithm ed25519 -out game-ticket.pem
#   openssl pkey -in game-ticket.pem -pubout -out game-ticket.pub.pem
# Paste the private key on one line with its line breaks written as \n. docker compose turns those back
# into newlines itself, and platform-api does it for the readers that do not (node's --env-file):
#   GAME_TICKET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMC4CAQAwBQYDK2VwBCIE...\n-----END PRIVATE KEY-----\n"
GAME_TICKET_PRIVATE_KEY=
# How long a ticket is worth. Five minutes when unset, which is what the spec asks for.
GAME_TICKET_TTL_SECONDS=300

# Local ports
PLATFORM_API_PORT=3000
GAME_SERVER_PORT=2567
