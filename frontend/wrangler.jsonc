{
  // Cloudflare Workers with Static Assets: serves the Vite build with no server code.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eldritch-alley",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
