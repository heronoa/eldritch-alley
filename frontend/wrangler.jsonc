{
  // Cloudflare Workers com Static Assets: serve o build do Vite sem código de servidor.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mystic-alley",
  "compatibility_date": "2026-01-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
